#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/minieap-scu --conf-file /etc/minieap-scu.conf
    procd_set_param respawn 3600 30 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/minieap-scu.conf
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger minieap-scu
}
